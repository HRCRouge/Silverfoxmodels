<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin login — Silver Fox Models</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-login-shell">
    <div class="admin-login-card">
      <img src="/public/images/logo.png" alt="Silver Fox Models" style="height:48px; margin-bottom:20px;">
      <h2 style="font-size:1.4rem;">Admin sign in</h2>
      <p style="color:#777; font-size:0.88rem; margin:8px 0 24px;">Manage models, rates, and contact info.</p>

      <% if (error) { %><div class="form-error"><%= error %></div><% } %>

      <form method="POST" action="/admin/login">
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" autocomplete="username" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-gold" style="width:100%; justify-content:center;">Sign in</button>
      </form>
      <p style="margin-top:20px;"><a href="/" style="font-size:0.82rem; color:#886;">&larr; Back to site</a></p>
    </div>
  </div>
</body>
</html>
