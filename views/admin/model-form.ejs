<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= model ? 'Edit ' + model.name : 'Add model' %> — Admin</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <div class="admin-header">
      <h1><%= model ? 'Edit model' : 'Add a new model' %></h1>
      <a href="/admin" class="btn btn-sm btn-outline">&larr; Back to dashboard</a>
    </div>

    <div class="admin-card">
      <form method="POST" action="<%= formAction %>" enctype="multipart/form-data">
        <div class="field">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" value="<%= model ? model.name : '' %>" required>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div class="field">
            <label for="gender">Gender</label>
            <select id="gender" name="gender">
              <% ['Female','Male','Non-binary'].forEach(g => { %>
                <option value="<%= g %>" <%= model && model.gender === g ? 'selected' : '' %>><%= g %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="age">Age</label>
            <input type="text" id="age" name="age" value="<%= model ? model.age : '' %>" placeholder="e.g. 22">
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div class="field">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= model ? model.location : '' %>" placeholder="e.g. Kathmandu">
          </div>
          <div class="field">
            <label for="availability">Availability</label>
            <input type="text" id="availability" name="availability" value="<%= model ? model.availability : '' %>" placeholder="e.g. Flexible, Weekends">
          </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
          <div class="field">
            <label for="height">Height</label>
            <input type="text" id="height" name="height" value="<%= model ? model.height : '' %>" placeholder="5'6&quot;">
          </div>
          <div class="field">
            <label for="shoes">Shoes</label>
            <input type="text" id="shoes" name="shoes" value="<%= model ? model.shoes : '' %>" placeholder="US 7">
          </div>
          <div class="field">
            <label for="hair">Hair</label>
            <input type="text" id="hair" name="hair" value="<%= model ? model.hair : '' %>" placeholder="Black">
          </div>
          <div class="field">
            <label for="eyes">Eyes</label>
            <input type="text" id="eyes" name="eyes" value="<%= model ? model.eyes : '' %>" placeholder="Brown">
          </div>
        </div>

        <div class="field">
          <label for="about">About</label>
          <textarea id="about" name="about" rows="4"><%= model ? model.about : '' %></textarea>
        </div>

        <div class="field">
          <label for="idealFor">Ideal for (comma-separated)</label>
          <input type="text" id="idealFor" name="idealFor" value="<%= model ? model.idealFor.join(', ') : '' %>" placeholder="Travel campaigns, Boutique brands">
        </div>

        <div class="field">
          <label for="photos">Add photos (JPG, PNG, or WEBP — up to 6 at a time)</label>
          <input type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp" multiple>
        </div>

        <% if (model && model.photos && model.photos.length) { %>
          <p class="sub" style="margin-bottom:4px;">Current photos (click × to remove)</p>
          <div class="photo-thumb-grid">
            <% model.photos.forEach((p, i) => { %>
              <div class="photo-thumb">
                <img src="<%= p %>" alt="Photo <%= i+1 %>">
                <form method="POST" action="/admin/models/<%= model.id %>/photos/<%= i %>/delete" onsubmit="return confirm('Remove this photo?');">
                  <button type="submit" title="Remove photo">&times;</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>

        <div class="field" style="flex-direction:row; align-items:center; gap:8px; margin-top:20px;">
          <input type="checkbox" id="active" name="active" style="width:auto;" <%= (!model || model.active) ? 'checked' : '' %>>
          <label for="active" style="margin:0;">Visible on the public site</label>
        </div>

        <button type="submit" class="btn btn-gold" style="margin-top:12px;"><%= model ? 'Save changes' : 'Add model' %></button>
      </form>
    </div>
  </div>
</body>
</html>
