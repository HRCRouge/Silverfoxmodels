<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit rate card — Admin</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <div class="admin-header">
      <h1>Edit rate card</h1>
      <a href="/admin" class="btn btn-sm btn-outline">&larr; Back to dashboard</a>
    </div>

    <div class="admin-card">
      <p class="sub">Leave "Service" blank on a row to remove it when you save. Use "+ Add row" for a new service.</p>
      <form method="POST" action="/admin/rates">
        <div style="display:grid; grid-template-columns:1.4fr 1.6fr 0.9fr 1fr 1.6fr auto; gap:8px; margin-bottom:10px; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; color:#886;">
          <span>Service</span><span>Description</span><span>Duration</span><span>Rate</span><span>Notes</span><span></span>
        </div>

        <div id="rate-rows">
          <% rateCard.forEach(r => { %>
            <div class="rate-row-grid">
              <input type="text" name="serviceType" value="<%= r.serviceType %>">
              <input type="text" name="description" value="<%= r.description %>">
              <input type="text" name="duration" value="<%= r.duration %>">
              <input type="text" name="rate" value="<%= r.rate %>">
              <input type="text" name="notes" value="<%= r.notes %>">
              <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()">&times;</button>
            </div>
          <% }) %>
        </div>

        <button type="button" id="add-row" class="btn btn-sm btn-outline" style="margin-top:8px;">+ Add row</button>

        <div class="field" style="margin-top:24px;">
          <label for="rateCardNotes">Rate card intro / notes</label>
          <textarea id="rateCardNotes" name="rateCardNotes" rows="3"><%= notes %></textarea>
        </div>

        <button type="submit" class="btn btn-gold" style="margin-top:8px;">Save rate card</button>
      </form>
    </div>
  </div>

  <script>
    document.getElementById('add-row').addEventListener('click', function () {
      const container = document.getElementById('rate-rows');
      const row = document.createElement('div');
      row.className = 'rate-row-grid';
      row.innerHTML = `
        <input type="text" name="serviceType">
        <input type="text" name="description">
        <input type="text" name="duration">
        <input type="text" name="rate">
        <input type="text" name="notes">
        <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()">&times;</button>
      `;
      container.appendChild(row);
    });
  </script>
</body>
</html>
