<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/header', { page }) %>

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Commercial Talent Agency &middot; Nepal</p>
      <h1><%= site.tagline %></h1>
      <p class="lead"><%= site.heroText %></p>
      <div class="hero-actions">
        <a href="/models" class="btn btn-gold">View our models</a>
        <a href="/rates" class="btn btn-outline">See the rate card</a>
      </div>
    </div>
    <div class="hero-mark">
      <img src="/public/images/logo.png" alt="Silver Fox Models fox mark">
    </div>
  </div>
</section>

<section class="how">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>Booking, made straightforward.</h2>
    <div class="how-grid">
      <% site.howItWorks.forEach((item, i) => { %>
        <div class="how-item">
          <span class="how-index">0<%= i + 1 %></span>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">On our roster</p>
        <h2>Featured models</h2>
      </div>
      <a href="/models" class="btn btn-outline">View full roster</a>
    </div>
    <div class="model-grid">
      <% featured.forEach(m => { %>
        <a href="/models/<%= m.id %>" class="model-card">
          <div class="model-photo">
            <% if (m.photos && m.photos[0]) { %>
              <img src="<%= m.photos[0] %>" alt="<%= m.name %>">
            <% } else { %>
              <span class="placeholder"><%= m.name.charAt(0) %></span>
            <% } %>
            <span class="model-tag"><%= m.gender %></span>
          </div>
          <div class="model-info">
            <h3><%= m.name %></h3>
            <p class="meta"><%= m.location %> &middot; <%= m.availability %></p>
            <span class="view-link">View profile &rarr;</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section panel-bone">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Why work with us</p>
        <h2>No upfront fees. No ambiguity.</h2>
        <p class="silver">If a brand confirms a project, you get paid directly and we take a 25% commission from that confirmed booking &mdash; never upfront, never before you're paid. There are no joining fees or hidden charges. Before any shoot, you'll get a written agreement covering the project, payment, and usage rights.</p>
      </div>
    </div>
    <div class="hero-actions">
      <a href="/contact" class="btn btn-gold">Get in touch</a>
      <a href="/models" class="btn btn-outline">Meet current models</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
